[Unit]
Description=Hermes Local TTS StyleTTS2 router worker
After=network-online.target hermes-local-tts-english.service
Requires=hermes-local-tts-english.service

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/.spike-venv/bin/python __PROJECT_DIR__/runtime/server.py
Restart=on-failure
RestartSec=3
Environment=OMP_NUM_THREADS=6

[Install]
WantedBy=default.target
