#!/usr/bin/env python3
from __future__ import annotations
import argparse,json,subprocess,sys,time,urllib.request
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1];HOME=Path.home();UNITS=HOME/'.config/systemd/user'
def run(*cmd):subprocess.run(cmd,check=True)
def unit(name,python,script):return f'''[Unit]\nDescription=Hermes Local TTS {name}\nAfter=network-online.target\n\n[Service]\nType=simple\nWorkingDirectory={ROOT}\nExecStart={python} {script}\nRestart=on-failure\nRestartSec=3\nEnvironment=PYTHONPATH={ROOT}\nEnvironment=OMP_NUM_THREADS=6\n\n[Install]\nWantedBy=default.target\n'''
def wait_url(url,seconds=120):
 end=time.monotonic()+seconds
 while time.monotonic()<end:
  try:return urllib.request.urlopen(url,timeout=2).read()
  except Exception:time.sleep(1)
 raise RuntimeError(f'timed out waiting for {url}')
def install(default,skip_plugin_install=False):
 if not shutil_which('uv'):raise SystemExit('uv is required: https://docs.astral.sh/uv/')
 run('uv','venv',str(ROOT/'.fast-venv'),'--python','3.11','--clear');run('uv','pip','install','--python',str(ROOT/'.fast-venv/bin/python'),'supertonic==1.3.1')
 run('uv','venv',str(ROOT/'.quality-venv'),'--python','3.11','--clear');run('uv','pip','install','--python',str(ROOT/'.quality-venv/bin/python'),'torch==2.8.0','torchaudio==2.8.0','--index-url','https://download.pytorch.org/whl/cpu');run('uv','pip','install','--python',str(ROOT/'.quality-venv/bin/python'),'git+https://github.com/patriotyk/styletts2-inference@209352700cf703a05ff94501290095dd9072fd5f','git+https://github.com/patriotyk/ukrainian-word-stress.git@a124470baf869573182f549c0bc8ec251860d28b','git+https://github.com/patriotyk/ipa-uk.git@3faf05ec50fd4880965b6c76f8e479a4f82117f5','soundfile','scipy','librosa','ctranslate2','sentencepiece','transformers==5.0.0','huggingface-hub')
 run('uv','venv',str(ROOT/'.english-venv'),'--python','3.11','--clear');run('uv','pip','install','--python',str(ROOT/'.english-venv/bin/python'),'torch==2.8.0','--index-url','https://download.pytorch.org/whl/cpu');run('uv','pip','install','--python',str(ROOT/'.english-venv/bin/python'),'kokoro-onnx==0.5.0','soundfile','misaki-fork[en]')
 model=ROOT/'.models/kokoro';model.mkdir(parents=True,exist_ok=True)
 for url,name in [('https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files/kokoro-v1.0.int8.onnx','kokoro-v1.0.int8.onnx'),('https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files/voices-v1.0.bin','voices-v1.0.bin')]:
  if not (model/name).exists():run('curl','-fL','--retry','3','-o',str(model/name),url)
 UNITS.mkdir(parents=True,exist_ok=True)
 specs={'router':(sys.executable,ROOT/'runtime/router_server.py'),'fast':(ROOT/'.fast-venv/bin/python',ROOT/'runtime/fast_server.py'),'quality':(ROOT/'.quality-venv/bin/python',ROOT/'runtime/server.py'),'english':(ROOT/'.english-venv/bin/python',ROOT/'runtime/english_server.py')}
 for n,(py,sc) in specs.items():(UNITS/f'hermes-local-tts-{n}.service').write_text(unit(n,py,sc))
 run('systemctl','--user','daemon-reload');run('systemctl','--user','enable','--now','hermes-local-tts-router.service');wait_url('http://127.0.0.1:8765/health');set_mode(default)
 if not skip_plugin_install:run('hermes','plugins','install','dmmeteo/hermes-local-tts','--enable','--force')
 run('hermes','config','set','tts.provider','local_tts')
 print('Installed Hermes Local TTS. Restart the Hermes gateway once so it loads the plugin commands.')
def set_mode(value):
 req=urllib.request.Request('http://127.0.0.1:8765/mode',data=json.dumps({'mode':value}).encode(),headers={'Content-Type':'application/json'});print(urllib.request.urlopen(req,timeout=330).read().decode())
def status():print(urllib.request.urlopen('http://127.0.0.1:8765/health',timeout=5).read().decode())
def shutil_which(name):
 import shutil;return shutil.which(name)
p=argparse.ArgumentParser(prog='hermes-local-tts');s=p.add_subparsers(dest='cmd',required=True);i=s.add_parser('install');i.add_argument('--default',choices=['fast','quality'],default='fast');i.add_argument('--skip-plugin-install',action='store_true',help=argparse.SUPPRESS);m=s.add_parser('mode');m.add_argument('mode',choices=['fast','quality']);s.add_parser('status');a=p.parse_args();install(a.default,a.skip_plugin_install) if a.cmd=='install' else set_mode(a.mode) if a.cmd=='mode' else status()
